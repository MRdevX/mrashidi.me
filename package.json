{
  "name": "mrashidi.me",
  "version": "0.2.12",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:fast": "pnpm --filter @mrashidi/web build:fast",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @mrashidi/web test:e2e",
    "eval:ask-mr": "pnpm --filter @mrashidi/web eval:ask-mr",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:agent-tooling": "node scripts/check-agent-tooling.mjs",
    "gate": "pnpm check && pnpm check:agent-tooling && pnpm check-migrations && turbo run typecheck test",
    "gate:affected": "pnpm check && pnpm check:agent-tooling && pnpm check-migrations && turbo run typecheck test --filter=...[origin/main]",
    "house-rules:sync": "node scripts/house-rules.mjs sync",
    "house-rules:install": "node scripts/house-rules.mjs install",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "release": "npx standard-version",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "reinstall": "pnpm clean && pnpm install",
    "check-migrations": "node scripts/check-migrations.mjs",
    "dev:api": "pnpm --filter @mrashidi/api dev",
    "dev:web": "pnpm --filter @mrashidi/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,css,json}": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
  }
}
