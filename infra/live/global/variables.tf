variable "cloudflare_api_token" {
  description = "Cloudflare API token with Zone DNS edit on mrashidi.me."
  type        = string
  sensitive   = true
}

variable "zone_id" {
  description = "Zone ID of mrashidi.me."
  type        = string
  default     = "e4e27fbd7bfea8bd87ea5094e8373279"
}

variable "dns_records" {
  description = "Zone DNS records keyed by a stable slug, generated by infra/scripts/fetch-zone-import.mjs. Worker and R2 custom-domain records are not listed: their owners create them."
  type = map(object({
    name     = string
    type     = string
    content  = string
    ttl      = optional(number, 1)
    proxied  = optional(bool, false)
    priority = optional(number)
    comment  = optional(string)
  }))
}
