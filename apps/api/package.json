{
  "name": "@mrashidi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app": "./src/app.ts",
    "#bindings": "./src/bindings.ts",
    "#db/*": "./src/db/*",
    "#modules/*": "./src/modules/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:update": "vitest run --update",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mrashidi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mrashidi-db --remote",
    "db:seed": "tsx scripts/seed.ts",
    "cf:deploy": "pnpm db:migrate:remote && wrangler deploy",
    "clean": "rm -rf .wrangler .turbo",
    "eval:ask-mr": "NODE_NO_WARNINGS=1 tsx scripts/ask-mr-eval.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.35",
    "@mrashidi/types": "workspace:*",
    "@react-email/render": "^2.2.0",
    "agents": "^0.32.0",
    "ai": "catalog:",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "^4.158.0"
  }
}
