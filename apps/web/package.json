{
  "name": "@mrashidi/web",
  "version": "0.2.12",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "generate-assets": "sh -c 'pnpm generate-sitemap & _s=$!; pnpm generate-og-images & _o=$!; _e=0; wait $_s || _e=1; wait $_o || _e=1; exit $_e'",
    "build": "NEXT_TELEMETRY_DISABLED=1 pnpm generate-assets && next build",
    "build:fast": "SKIP_PWA=true next build",
    "build:ci": "pnpm build:fast",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "next typegen && tsc --noEmit",
    "generate-sitemap": "NODE_NO_WARNINGS=1 tsx scripts/generate-sitemap.ts",
    "generate-og-images": "tsx scripts/generate-og-images.jsx",
    "eval:ask-mr": "NODE_NO_WARNINGS=1 tsx scripts/ask-mr-eval.ts",
    "analyze": "ANALYZE=true next build",
    "test:watch": "vitest",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.156",
    "@aws-sdk/client-ses": "^3.1156.0",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.2",
    "@mrashidi/types": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/render": "^2.1.1",
    "@sentry/nextjs": "^11.9.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.152",
    "botid": "^1.5.11",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.2.0",
    "framer-motion": "^14.6.0",
    "html-to-text": "^10.0.1",
    "ky": "^2.2.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-pwa": "^5.6.0",
    "pino": "^10.4.0",
    "pretty-bytes": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "sanitize-filename": "^1.6.4",
    "streamdown": "^2.7.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.5",
    "axe-core": "^4.14.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
