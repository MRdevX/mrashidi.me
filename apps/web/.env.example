# Copy to .env.local and fill in what you need. Every variable is optional unless noted.
# Schema and defaults: src/lib/core/env.ts

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=
# Comma-separated browser origins (with scheme) for APIs using .cors()
CORS_ALLOWED_ORIGINS=

# --- Ask MR (AI chat) ---
# The model runs in the API Worker on Workers AI; chat needs CONTENT_API_URL (pnpm dev:api).
# Max chat requests per day across all visitors (needs Upstash Redis to be enforced).
# Sized to stay inside the free 10,000 Workers AI neurons a day.
ASK_MR_DAILY_BUDGET=120
# Server kill switch for /api/chat
ASK_MR_ENABLED=true
# Set to false to hide the chat UI
NEXT_PUBLIC_ASK_MR_ENABLED=true

# --- Upstash Redis (rate limits, Ask MR budget and logs; in-memory fallback without it) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- reCAPTCHA v3 (contact form) ---
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Email (AWS SES) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_TO_ADDRESS=
EMAIL_SERVICE_API_KEY=
EMAIL_SERVICE_DOMAIN=
EMAIL_FROM=
EMAIL_TO=

# --- CV storage (Vercel Blob) ---
BLOB_STORE_URL=
CV_UPLOAD_TOKEN=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Content API (apps/api). Leave unset to use the fixture dataset locally.
# CONTENT_API_URL=http://localhost:8787
# CONTENT_API_TOKEN=local-dev-token
# REVALIDATE_SECRET=
